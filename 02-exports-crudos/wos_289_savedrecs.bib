@article{ WOS:001478811000001,
Author = {Zhu, Yun-Hao and Zhang, Zhong-Liang and Liu, Wan-An},
Title = {Iterative under-sampling for delisting risk prediction of Chinese listed
   companies based on financial information},
Journal = {ENGINEERING APPLICATIONS OF ARTIFICIAL INTELLIGENCE},
Year = {2025},
Volume = {153},
Month = {AUG 1},
Abstract = {The delisting of companies not only undermines corporate interests but
   also causes significant financial losses on investors, making the
   development of effective early warning models in delisting risk
   prediction (DRP) essential for improving corporate governance and
   guiding investment decisions. A major challenge in DRP is the
   class-imbalance problem between potential delisting and normal
   companies. The cost of false negatives is significantly higher than that
   of false positives, as missing a delisting event may lead to substantial
   financial losses. To address this, we propose a novel under-sampling
   framework inspired by the cautious decision-making mindset of investors.
   Our approach iteratively applies a soft-margin selection strategy during
   inter-group under-sampling to construct a balanced dataset, enabling
   base learners to focus on potential delisting cases while maintaining a
   robust precision-recall balance. We validate our method through
   extensive experiments on datasets collected from China's security market
   by comparing it with eighteen existing imbalanced DRP techniques across
   four performance metrics. The results are rigorously analyzed using
   statistical methods. These findings demonstrate the superiority of our
   method for risk assessment across multiple timeframes in financial
   markets.},
