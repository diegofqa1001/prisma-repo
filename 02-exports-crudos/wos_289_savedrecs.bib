@article{ WOS:001119274500002,
Author = {Darmayanti, Ni Putu Ayu and Wiagustini, Ni Luh Putu and Artini, Luh Gede
   Sri and Candraningrat, Ica Rika},
Title = {Driving Millennials To Be Investors: The Case Of Investment Decision
   Performance In Indonesian Capital Market},
Journal = {QUALITY-ACCESS TO SUCCESS},
Year = {2023},
Volume = {24},
Number = {196},
Pages = {167-174},
Month = {AUG},
Abstract = {Investment in the capital market offers the expectation of a relatively
   high rate of return. However, it is also considered risky, raising
   various obstacles in achieving the investment performance that investors
   expect. The present study investigated the effect of risk tolerance,
   financial literacy, and risky investment decisions regarding the
   investment performance made by millennial investors in Indonesia.
   Therefore, the objectives of this study were accomplished by examining
   the millennial who invested in the Indonesian capital market in several
   steps. Data collection was performed utilizing the survey method by
   administering electronic questionnaire media. The purposive sampling
   method was employed, resulting in a sample of 300 participants. Further,
   the data analysis was achieved by applying the partial least square
   method. Accordingly, the analysis results indicated that financial
   literacy, risk tolerance, and risky investment decisions were predictors
   of the investment performance of millennial investors in Indonesia. The
   mediation test indicated that risky investment decisions partially
   mediated the effect of financial literacy and risk tolerance toward
   investment performance. The study contributes to the literature by
   developing an integrated model between investment performance, risky
   investment decisions, risk tolerance, and financial literacy. Moreover,
   the practical implications of the results of this study offer beneficial
   impacts to investment advisors,policymakers,investors, and potential
   investors to help them enhance investment performance.},
