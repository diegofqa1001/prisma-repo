@article{ WOS:000550684000045,
Author = {Ma, Liyi and Li, Yingxia and Li, Dandan and Li, Hui and Wang, Yane and
   Ren, Chengmei},
Title = {Risk Identification and Decision Making for P2P Companies: An Empirical
   Study in the Bohai Coast Regions},
Journal = {JOURNAL OF COASTAL RESEARCH},
Year = {2020},
Number = {106},
Pages = {191-196},
Month = {SUM},
Abstract = {This paper takes risk identification and risk profiling of new types of
   peer-to-peer (P2P) companies as the theme, efficiently integrates
   multidimensional variables, and builds a corporate risk identification
   model. On the basis of this model, it describes the risk profiling of
   P2P companies, thereby helping investors better identify corporate risks
   and reduce potential loss. This paper takes the data of 633 P2P
   platforms in the Bohai Coast regions extracted from the two
   authoritative websites of Wdzj and Tianyancha as examples, uses logistic
   regression models to analyze 16 variables in five dimensions, and draws
   the following conclusions: change log and platform transfer fees are
   significantly positively related to platform operating risks; platform
   background, platform management fees, and automatic bidding are
   significantly negatively related. Finally, it provides relevant
   recommendations on how investors choose a platform.},
Publisher = {COASTAL EDUCATION \& RESEARCH FOUNDATION},
Address = {9034 Twilight Hill Court, Charlotte, NC, UNITED STATES},
Type = {Article},
Language = {English},
Affiliation = {Ma, LY (Corresponding Author), Beijing Union Univ, Sch Management, Beijing 100010, Peoples R China.
   Ma, Liyi; Li, Yingxia; Li, Dandan; Li, Hui; Wang, Yane; Ren, Chengmei, Beijing Union Univ, Sch Management, Beijing 100010, Peoples R China.},
DOI = {10.2112/SI106-045.1},
ISSN = {0749-0208},
EISSN = {1551-5036},
Keywords = {P2P online lending platforms; risk identification model; logistic
