@article{ WOS:000510058100001,
Author = {Lee, Younghwan and Park, Haerang},
Title = {Bank risk-taking and market discipline: Evidence from CoCo bonds in
   Korea},
Journal = {JOURNAL OF FUTURES MARKETS},
Year = {2020},
Volume = {40},
Number = {6},
Pages = {885-894},
Month = {JUN},
Abstract = {We investigate whether the risk profile of contingent convertible (CoCo)
   bonds is well-priced by testing the sensitivity of bond spreads to bank
   asset volatility. While equity holders (bankers) have an incentive to
   make riskier investments to trigger the write-off, such risk-taking
   behavior can be contained if CoCo bond investors punish it by demanding
   higher returns. We have found that investors in the Korean financial
   market understand the risk profile of CoCo bonds and require higher
   returns for the additional bank risk, which suggests the presence of
   market discipline with regard to CoCo bonds.},
