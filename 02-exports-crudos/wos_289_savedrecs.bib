@article{ WOS:001834815500001,
Author = {Solanki, Kamini and Seetharam, Yudhvir and Page, Daniel},
Title = {A cultural finance perspective on the low volatility anomaly},
Journal = {RESEARCH IN INTERNATIONAL BUSINESS AND FINANCE},
Year = {2026},
Volume = {90},
Month = {OCT},
Abstract = {Purpose: This research investigates whether cross-country cultural
   differences help explain stock market return patterns associated with
   the low volatility anomaly. Cultural differences are captured using
   Hofstede's individualism and uncertainty avoidance indices (Hofstede,
   2001), which have been associated in prior research with systematic
   differences in how investors process information, respond to
   uncertainty, and exhibit overconfidence-and loss-aversion-related
   behaviour. Methodology: The empirical analysis proceeds in three steps:
   (1) we assess whether the individualism and uncertainty avoidance
   indices behave consistently with cultural channels linked in prior
   research to overconfidence-and loss-aversion-related behaviour, using
   regression analysis; (2) we test whether each cultural index is related
   to the cross-country profitability of low-volatility strategies; and (3)
   we estimate cross-country regressions that include the two cultural
   indices alongside other proposed determinants of low volatility.
   Findings: We find that individualism helps explain cross-country
   variation in low volatility returns. This supports the individualism
   hypothesis: investors in highly individualistic countries place greater
   weight on their own judgement and information processing, which can
   contribute to abnormal returns. In contrast, the evidence does not
   support the proposed UAI-based loss-aversion hypothesis. UAI is
   insignificant in some specifications and significantly negative in
   others, indicating that the results run counter to the predicted
   positive relationship between uncertainty avoidance and low-volatility
   returns. Consistent with prior studies, we caution against using the
   uncertainty avoidance index as a direct proxy for risk acceptance or
   loss aversion. Originality: Cross-cultural tests of stock market
   anomalies have largely focused on momentum. This study links cultural
   finance to the low volatility anomaly, providing new evidence on its
   drivers and reinforcing the relevance of cultural finance in
   international asset pricing research.},
