@article{ WOS:000571546200001,
Author = {Jiang, Jie and Shrider, David G. and Ting, Huangwen and Wu, Yanran},
Title = {Are mutual fund investors loss averse? Evidence from China},
Journal = {FINANCIAL REVIEW},
Year = {2021},
Volume = {56},
Number = {2},
Pages = {231-250},
Month = {MAY},
Abstract = {Research shows that many investors are loss averse (reluctant to sell
   investments that have lost value). However, there is open debate about
   whether mutual fund investors suffer from loss aversion. We use over
   300,000 Chinese mutual fund investor accounts from five open-end funds
   to test for loss aversion using survival analysis controlling for
   time-varying covariates (Cox analysis). We find strong evidence of loss
   aversion as these investors are between 60\% and 91\% less likely to
   sell a fund that is down in value across the five funds. We also find
   that more sophisticated investors are less loss averse.},
