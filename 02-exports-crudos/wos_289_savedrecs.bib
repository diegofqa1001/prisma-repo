@article{ WOS:001560366600001,
Author = {Chammaa, Claude and Haddad, Leina},
Title = {Artificial intelligence and behavioural finance biases: improving
   Lebanese investors decision-making},
Journal = {JOURNAL OF DECISION SYSTEMS},
Year = {2025},
Volume = {34},
Number = {1},
Month = {JAN 2},
Abstract = {This article highlights the importance of behavioural Finance in
   decision-making within a society experiencing rapid technological
   development. Despite the increasing literature on behavioural Finance in
   growing economies, a significant gap exists in understanding how
   Lebanon's unique socioeconomic situation influences investor
   decision-making. Since Lebanon presents an underexplored opportunity to
   examine the dynamics of behavioural Finance, our research highlights the
   need for an in-depth investigation into behavioural Finance within the
   Lebanese market. The impact of AI and biases, including overconfidence,
   availability, anchoring, and loss aversion, needs further examination in
   this context. The first theoretical part will clarify the notions of
   heuristics and behavioural biases identified in investors and present
   previous studies. This study employs a mixed-methodology approach,
   presenting findings and analysis from a survey conducted among 110
   decision-makers in Lebanon's small and medium-sized enterprises (SMEs).
   It aims to examine investors' rationality and identify judgement errors
   in their decision-making processes.},
