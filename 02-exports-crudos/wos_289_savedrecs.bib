@article{ WOS:001607494100001,
Author = {Wang, Jying-Nan and Liu, Hung-Chun and Hsu, Yuan-Teng},
Title = {Mechanisms Underlying US-China Tensions and Stock Price Crash Risk:
   Evidence from China},
Journal = {JOURNAL OF BEHAVIORAL FINANCE},
Year = {2025},
Month = {2025 OCT 31},
Abstract = {This study examines how behavioral biases shape stock price crash risk
   under geopolitical tensions, focusing on the newly proposed U.S.-China
   Tension (UCT) Index. We argue that geopolitical shocks act as
   narrative-driven behavioral triggers that induce systematic cognitive
   and emotional responses among investors. Using data on Chinese A-share
   listed firms from 2014 to 2023, our results show that heightened UCT
   levels significantly increase crash risk, particularly for state-owned
   firms and those without foreign diversification. Mechanisms such as
   institutional herding, bad-news hoarding, and overreaction amplify
   behavioral fragility when firms are under stress. Our findings extend
   behavioral finance theory by demonstrating how narratives surrounding
   bilateral tensions distort risk perception, drive asymmetric investor
   reactions, and contribute to the behavioral foundations of systemic risk
   transmission in emerging markets.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
