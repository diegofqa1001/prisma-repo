Affiliation = {Quenneville, R (Corresponding Author), Carleton Univ, Ottawa, ON, Canada.
   Quenneville, Rheann; Hebb, Tessa, Carleton Univ, Ottawa, ON, Canada.},
DOI = {10.29173/cjnser818},
ISSN = {1920-9355},
Keywords = {community bonds; impact investing; community wealth building;
