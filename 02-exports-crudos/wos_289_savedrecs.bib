@article{ WOS:001586813700001,
Author = {Subedi, Phul Prasad and Sharma, Dilli Raj and Sharma, Bhumiswor},
Title = {Herding Behavior, Risk Perception, and Investment Performance: A Serial
   Mediation Analysis},
Journal = {SCIENTIFIC PAPERS OF THE UNIVERSITY OF PARDUBICE-SERIES D-FACULTY OF
   ECONOMICS AND ADMINISTRATION},
Year = {2025},
Volume = {33},
Number = {1},
Abstract = {This study examines the impact of herd behavior on investment
   performance by investigating the serial mediating effects of perceived
   risk and investment decisions, drawing on the principles of behavioral
   finance theory. Using a crosssectional design, data were collected
   through a structured questionnaire from 640 investors in the Nepal Stock
   Exchange (NEPSE) and analyzed with SPSS AMOS, applying SEM and Hayes'
   Process Macros to test the hypotheses. The results reveal that herding
   behavior has a non-significant direct effect on investment performance
   (IP) ((beta = 0.064, p = 0.138) but significantly affects IP indirectly
   through risk perception (RP) ((beta= 0.086, p < 0.001) and investment
   decisions (ID) ((beta = 0.035, p < 0.001). The serial mediation pathway
   via RP -> ID significantly transmits the influence of herding on
   investors' performance ((beta = 0.028, p < 0.001). The study contributes
   to behavioral finance theory by extending the basic mediation model to
   include risk perception and investment choices as serial mediators in
   the Nepalese context, which has been rarely examined before.
   Practically, the findings offer valuable insights for constructing
   robust investment models, raising awareness of behavioral biases, and
   informing investors, researchers, and policymakers in the development of
   more effective strategies and policies.},
Publisher = {Univ Pardubice, Fac Economics Adm},
